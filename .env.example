# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Sync — how often (minutes) to pull the full dataset from Supabase.
# Higher = less Supabase egress (bandwidth). Default 5. Pushing local
# changes is unaffected and still happens every 30s.
VITE_SYNC_PULL_MINUTES=5

